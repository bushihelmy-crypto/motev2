{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "mote-persistence-cloudflare-test",
    "main": "tests/worker.ts",
    "compatibility_date": "2026-08-20",
    "durable_objects": {
        "bindings": [
            {
                "name": "PERSISTENCE_TEST_OBJECTS",
                "class_name": "PersistenceTestDurableObject",
            },
        ],
    },
    "exports": {
        "PersistenceTestDurableObject": {
            "type": "durable-object",
            "storage": "sqlite",
        },
    },
}
