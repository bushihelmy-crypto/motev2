{
  "name": "@mote/container-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare-native Agent containers and Durable Object persistence for Mote.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mote contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bushihelmy-crypto/motev2.git",
    "directory": "mote-resource/container/cloudflare"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4"
    }
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "pnpm run check:static && pnpm run test && pnpm run build",
    "check:ci": "pnpm run check:static && pnpm run test:coverage && pnpm run build",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run types:check && pnpm run typecheck",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "oxlint --deny-warnings src tests vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime false",
    "types:check": "wrangler types src/worker-configuration.d.ts --include-runtime false --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@vitest/coverage-istanbul": "5.0.0",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
