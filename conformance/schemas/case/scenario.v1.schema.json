{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mote.dev/conformance/case/scenario.v1.schema.json",
  "title": "Mote conformance scenario envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_version", "case_id", "protocol_versions", "initial", "steps", "expect"],
  "properties": {
    "$schema": {"type": "string"},
    "case_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "description": {"type": "string", "minLength": 1},
    "protocol_versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "initial": {},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "input": {},
          "expect": {}
        }
      }
    },
    "expect": {}
  }
}
