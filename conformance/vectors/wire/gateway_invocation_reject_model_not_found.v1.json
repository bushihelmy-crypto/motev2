    "input": {
      "kind": "generate",
      "messages": [{"role": "user", "content": [{"type": "text", "text": "hello"}]}]
    },
    "features": []
  },
  "expect": {
    "outcome": "reject",
    "error_code": "INVALID_REQUEST"
  }
